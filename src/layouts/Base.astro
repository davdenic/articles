---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  /** Absolute URL to the social/share image. */
  image?: string;
  type?: 'website' | 'article';
  author?: string;
  published?: Date;
}
const { title, description, image, type = 'website', author, published } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteName = 'David Denicolò';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ?? new URL(`${base}/favicon-512.png`, Astro.site).href;
const desc = description?.trim() ?? '';

// schema.org JSON-LD — Article for posts, WebSite for the index.
const ld =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        ...(desc && { description: desc }),
        image: ogImage,
        url: canonical,
        ...(author && { author: { '@type': 'Person', name: author } }),
        ...(published && { datePublished: published.toISOString().slice(0, 10) }),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: title,
        ...(desc && { description: desc }),
        url: canonical,
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {desc && <meta name="description" content={desc} />}
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {desc && <meta property="og:description" content={desc} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    {type === 'article' && author && <meta property="article:author" content={author} />}
    {
      type === 'article' && published && (
        <meta property="article:published_time" content={published.toISOString()} />
      )
    }

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {desc && <meta name="twitter:description" content={desc} />}
    <meta name="twitter:image" content={ogImage} />

    {/* Favicons */}
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}/favicon-512.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />

    {/* Apply the saved theme before paint to avoid a flash of the wrong theme. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="topbar">
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
      </button>
    </div>
    <main>
      <slot />
    </main>

    <script>
      const btn = document.getElementById('theme-toggle');
      const mql = window.matchMedia('(prefers-color-scheme: dark)');

      function effective() {
        const t = document.documentElement.dataset.theme;
        return t === 'dark' || t === 'light' ? t : mql.matches ? 'dark' : 'light';
      }

      function sync() {
        const eff = effective();
        btn?.setAttribute('data-eff', eff);
        btn?.setAttribute(
          'aria-label',
          eff === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
        );
      }

      btn?.addEventListener('click', () => {
        const next = effective() === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
        sync();
      });

      mql.addEventListener('change', () => {
        if (!document.documentElement.dataset.theme) sync();
      });

      sync();
    </script>
  </body>
</html>
