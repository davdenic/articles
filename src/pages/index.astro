---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { hexClusterMosaic, centroid, polyArea, pathFrom, wrapTitle } from '../lib/voronoi';

// Live articles (draft !== true), newest first — the newest lands top-centre.
const isDev = import.meta.env.DEV;
const articles = (await getCollection('articles'))
  .filter((a) => isDev || !a.data.draft)
  .sort((a, b) => (b.data.published?.valueOf() ?? 0) - (a.data.published?.valueOf() ?? 0));

const publicSlug = (id: string) => id.replace(/^\d+-/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const articleImages = import.meta.glob('/src/content/articles/**/*.{png,jpg,jpeg,webp,avif,svg}');

// Mosaic frame (viewBox units; the SVG scales to full width).
const W = 1600;
const H = 1000;

// Article cells form a touching cluster of near-regular hexagons radiating from
// the top-centre (newest = apex). Small filler fills the space around it.
const { articleCells, fillerCells } = hexClusterMosaic(articles.length, W, H);

const fmtDate = (d?: Date) =>
  d ? d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }) : '';

// Resolve each article's hero image to an optimized URL + cell geometry.
const cards = await Promise.all(
  articles.map(async (a, i) => {
    let imageFile = a.data.image;
    if (!imageFile) {
      const m = a.body?.match(/!\[[^\]]*\]\(\.\/([^)]+)\)/);
      if (m) imageFile = m[1];
    }
    let src: string | null = null;
    if (imageFile) {
      const loader = articleImages[`/src/content/articles/${a.id}/${imageFile}`];
      if (loader) {
        const mod: any = await loader();
        if (imageFile.endsWith('.svg')) src = mod.default.src ?? mod.default;
        else src = (await getImage({ src: mod.default, format: 'webp', width: 900 })).src;
      }
    }
    const poly = articleCells[i];
    if (!poly || poly.length < 3) return null;
    const c = centroid(poly);
    const xs = poly.map((p) => p.x);
    const ys = poly.map((p) => p.y);
    const bx = Math.min(...xs);
    const by = Math.min(...ys);
    // scale the title to the cell so it always fits
    const cr = Math.sqrt(polyArea(poly) / Math.PI);
    const font = Math.max(16, Math.min(36, Math.round(cr * 0.3)));
    const lh = Math.round(font * 1.14);
    const maxChars = Math.max(9, Math.round((cr * 1.5) / (font * 0.52)));
    return {
      href: `${base}/${publicSlug(a.id)}/`,
      title: a.data.title,
      date: fmtDate(a.data.published),
      draft: a.data.draft,
      src,
      d: pathFrom(poly),
      cx: c.x,
      cy: c.y,
      bx,
      by,
      bw: Math.max(...xs) - bx,
      bh: Math.max(...ys) - by,
      font,
      lh,
      lines: wrapTitle(a.data.title, maxChars, 3),
      id: `cell-${i}`,
    };
  })
);
const visibleCards = cards.filter((c): c is NonNullable<typeof c> => c !== null);
---

<Base
  title="Articles"
  description="Articles by David Denicolò on AI-assisted software development and the engineering practices behind it."
>
  <div class="wide">
    <h1>Articles <span class="version">v0.42.0-rc1</span></h1>
    <p class="tagline">A mosaic of things I'm working out — the newest sits up top.</p>
  </div>

  <div class="bleed">
    <svg
      class="mosaic"
      viewBox={`0 0 ${W} ${H}`}
      role="list"
      aria-label="Articles"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        {visibleCards.map((c) => (
          <clipPath id={c.id}><path d={c.d} /></clipPath>
        ))}
      </defs>

      {/* filler cells — quiet, non-interactive */}
      {fillerCells.map((poly) => (
        <path class="filler" d={pathFrom(poly)} />
      ))}

      {/* article cells — image + title, clickable */}
      {visibleCards.map((c) => (
        <a href={c.href} role="listitem" aria-label={c.title} class="cell">
          {c.src ? (
            <image
              href={c.src}
              x={c.bx}
              y={c.by}
              width={c.bw}
              height={c.bh}
              preserveAspectRatio="xMidYMid slice"
              clip-path={`url(#${c.id})`}
            />
          ) : (
            <path d={c.d} class="cell-fallback" />
          )}
          <path d={c.d} class="cell-outline" />
          <text class="ttl" text-anchor="middle" font-size={c.font}>
            {c.lines.map((ln, k) => (
              <tspan x={c.cx} y={c.cy - ((c.lines.length - 1) * c.lh) / 2 - 2 + k * c.lh}>{ln}</tspan>
            ))}
          </text>
          <text
            class="dt"
            text-anchor="middle"
            font-size={Math.round(c.font * 0.6)}
            x={c.cx}
            y={c.cy - ((c.lines.length - 1) * c.lh) / 2 - 2 + c.lines.length * c.lh + 4}
          >
            {c.date}{c.draft ? ' · draft' : ''}
          </text>
        </a>
      ))}
    </svg>
  </div>
</Base>

<style>
  .wide { max-width: 72rem; margin-inline: auto; padding-inline: 1rem; }
  .tagline { color: var(--muted, #6b7280); margin: 0.4rem 0 0; }

  /* Full-bleed row for the mosaic. */
  .bleed {
    width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
    margin-top: 1.5rem;
  }
  .mosaic { display: block; width: 100%; height: auto; }

  .filler {
    fill: color-mix(in srgb, currentColor 8%, transparent);
    stroke: color-mix(in srgb, currentColor 4%, transparent);
    stroke-width: 2;
  }
  @media (prefers-color-scheme: dark) {
    .filler { fill: color-mix(in srgb, currentColor 12%, transparent); }
  }

  .cell { cursor: pointer; }
  .cell image { transition: opacity 0.16s ease; }
  .cell-outline {
    fill: none;
    stroke: var(--bg, #fff);
    stroke-width: 3;
  }
  .cell-fallback { fill: color-mix(in srgb, var(--accent, #2f5bea) 20%, transparent); }

  .cell:hover image { opacity: 0.88; }
  .cell:focus-visible { outline: none; }
  .cell:focus-visible .cell-outline { stroke: var(--accent, #2f5bea); stroke-width: 5; }

  .ttl {
    fill: #14171d;
    font-weight: 680;
    paint-order: stroke;
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 4px;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .dt {
    fill: #14171d;
    opacity: 0.62;
    paint-order: stroke;
    stroke: rgba(255, 255, 255, 0.85);
    stroke-width: 3px;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .cell image { transition: none; }
  }
</style>
