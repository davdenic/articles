---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';

// Only live articles (draft !== true). In dev, drafts stay visible for preview.
const isDev = import.meta.env.DEV;
const articles = (await getCollection('articles'))
  .filter((a) => isDev || !a.data.draft)
  .sort((a, b) => (b.data.published?.valueOf() ?? 0) - (a.data.published?.valueOf() ?? 0));

// Strip the leading NNNN- from the folder id to get the public slug.
const publicSlug = (id: string) => id.replace(/^\d+-/, '');

// Site base without a trailing slash, so link joins are unambiguous.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// All co-located article images, so each card image can be resolved here
// (same source of truth as the share image in [...slug].astro).
const articleImages = import.meta.glob('/src/content/articles/**/*.{png,jpg,jpeg,webp,avif,svg}');

// Tile size: `WxH` grid spans in 0.5 steps → fine tracks (grid runs at 2x
// resolution, so 1 logical unit = 2 tracks and 0.5 lands on a real track).
const spans = (size?: string): { cx: number; cy: number } => {
  const [w, h] = (size ?? '1x1').split('x').map(Number);
  return {
    cx: Math.max(1, Math.round((w || 1) * 2)),
    cy: Math.max(1, Math.round((h || 1) * 2)),
  };
};

// For each article, resolve a card image: frontmatter `image` → first body image.
// Cards crop to fill their tile (object-fit: cover), so ask for a width that
// suits wider tiles.
const cards = await Promise.all(
  articles.map(async (a) => {
    let imageFile = a.data.image;
    if (!imageFile) {
      const m = a.body?.match(/!\[[^\]]*\]\(\.\/([^)]+)\)/);
      if (m) imageFile = m[1];
    }
    const { cx, cy } = spans(a.data.size);
    const pos = a.data.imagePosition;
    let img = null;
    if (imageFile) {
      const loader = articleImages[`/src/content/articles/${a.id}/${imageFile}`];
      if (loader) {
        const mod: any = await loader();
        if (imageFile.endsWith('.svg')) {
          // SVG is already scalable — use it as-is; getImage/sharp would not
          // meaningfully transform it (and can't emit webp from it).
          img = { src: mod.default.src ?? mod.default };
        } else {
          img = await getImage({ src: mod.default, format: 'webp', width: cx > 2 ? 1200 : 720 });
        }
      }
    }
    return {
      href: `${base}/${publicSlug(a.id)}/`,
      title: a.data.title,
      published: a.data.published,
      draft: a.data.draft,
      img,
      cx,
      cy,
      pos,
    };
  })
);

const fmtDate = (d?: Date) =>
  d
    ? d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })
    : '';
---

<Base
  title="Articles"
  description="Articles by David Denicolò on AI-assisted software development and the engineering practices behind it."
>
  <div class="wide">
    <h1>Articles <span class="version">v0.42.0-rc1</span></h1>
    <div class="mosaic">
      {cards.map((c) => (
        <a class="card" href={c.href} style={`--cx:${c.cx};--cy:${c.cy}${c.pos ? `;--pos:${c.pos}` : ''}`}>
          {c.img ? (
            <img
              src={c.img.src}
              alt={c.title}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="card-fallback" aria-hidden="true"><span>{c.title}</span></div>
          )}
          <div class="card-body">
            <h2 class="card-title">{c.title}</h2>
            <p class="card-meta">
              {fmtDate(c.published)}
              {c.draft && <span class="card-draft"> · draft</span>}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  /* Wider than the reading column — the mosaic wants room. */
  .wide {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  /* Playful version tag beside the title (42 — the answer to everything). */
  .version {
    font-size: 0.5em;
    font-weight: 400;
    opacity: 0.55;
    vertical-align: middle;
    letter-spacing: 0.02em;
  }

  /* CSS-grid masonry at 2x resolution: 2 fine tracks = 1 logical column, and
     grid-auto-rows is a half-unit, so `size` values in 0.5 steps map to whole
     tracks. `grid-auto-flow: dense` back-fills the gaps left by big tiles. */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(4, 1fr); /* = 2 logical columns */
    grid-auto-rows: 7rem;
    grid-auto-flow: dense;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 44rem) {
    .mosaic { grid-template-columns: repeat(6, 1fr); } /* 3 logical */
  }
  @media (min-width: 64rem) {
    .mosaic { grid-template-columns: repeat(8, 1fr); } /* 4 logical */
  }

  .card {
    /* Span W×H logical units → 2× fine tracks each. Over-wide spans are
       clamped to the available columns by the grid on narrow screens. */
    grid-column: span var(--cx, 2);
    grid-row: span var(--cy, 2);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 14px;
    overflow: hidden;
    background: transparent;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }

  /* Image (or fallback) fills the remaining tile height and crops to cover. */
  .card img,
  .card-fallback {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    object-fit: cover;
    /* Heroes are wide with the headline on the left; anchor left so a narrow
       tile crops the empty right side, not the title. */
    object-position: var(--pos, left center);
  }

  /* No-image articles: an accent-tinted block carrying the title. */
  .card-fallback {
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .card-fallback span {
    font-family: var(--font-heading, inherit);
    font-size: 1.25rem;
    line-height: 1.2;
    text-align: center;
    color: var(--accent);
  }

  .card-body {
    flex: 0 0 auto;
    padding: 0.85rem 1rem 1.05rem;
  }
  .card-title {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.25;
  }
  .card-meta {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .card-draft {
    color: var(--accent);
    opacity: 1;
  }
</style>
